# Used only for `npm run build:gh-pages` (vite --mode gh-pages).
# Points the statically-hosted GitHub Pages build at the API already running
# on Vercel, since GitHub Pages serves static files only and has no proxy.
# Not a secret: this is the same public URL reported by `vercel deploy --prod`.
VITE_API_BASE_URL=https://claudecodetreasuregame-wheat.vercel.app/api
